 {% set img = item['image'] | default('', true) | string | trim %}\n    <td class=\"col\" width=\"33%\" valign=\"top\" style=\"padding:8px; text-align:center;\">\n      <a href=\"{{ url | e }}\">\n        {% if img.startswith('https://') %}<img src=\"{{ img | e }}\" alt=\"{{ item['title'] | default('Product', true) | e }}\" width=\"168\">{% endif %}\n        <p>{{ item['title'] | default('', true) | e }}</p>\n      </a>\n    </td>\n  {% endfor %}\n  </tr></table></td></tr>\n  {% endif %}\n  <tr><td align=\"center\" style=\"padding:16px 24px 32px;\">\n    <a href=\"https://www.acme-outdoor.example/black-friday\" style=\"display:inline-block; padding:14px 28px; background-color:#222222; color:#ffffff;\">Shop the sale</a>\n  </td></tr>\n  <tr><td align=\"center\" style=\"padding:16px 24px; font-size:12px; color:#666666;\">\n    <p style=\"margin:0 0 8px;\">Acme Outdoor &middot; {{ project_variables.company_address }}</p>\n    <p style=\"margin:0;\">You're receiving this because you subscribed. <a href=\"{{ consent.page }}\">Unsubscribe or manage preferences</a></p>\n  </td></tr>\n</table>\n</body>\n</html>\n",
